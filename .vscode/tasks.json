{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Firmware Monitor",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/firmware/monitor-local.ps1", "-Port", "${input:firmwareSerialPort}", "-Seconds", "30"],
            "problemMatcher": []
        },
        {
            "label": "Firmware Build Diagnostics",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/firmware/build-local.ps1"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Firmware Flash Diagnostics",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/firmware/flash-local.ps1"],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Firmware Probe SWD",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/firmware/flash-local.ps1", "-ProbeOnly"],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "firmwareSerialPort",
            "type": "promptString",
            "description": "DM USART1 USB serial port",
            "default": "COM12"
        }
    ]
}
